run = "bash scripts/setup-replit.sh && cd backend && uvicorn main:app --host 0.0.0.0 --port 8080"
entrypoint = "backend/main.py"

[env]
PYTHONPATH = "/home/runner/${REPL_SLUG}"

modules = ["python-3.12", "nodejs-22"]

[deployment]
run = "cd backend && uvicorn main:app --host 0.0.0.0 --port 8080"
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80
